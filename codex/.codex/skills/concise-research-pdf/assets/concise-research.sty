\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{concise-research}[2026/09/10 Compact article style]
\RequirePackage[margin=0.85in]{geometry}
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern,microtype,graphicx,xcolor}
\RequirePackage{array,booktabs,tabularx,longtable}
\RequirePackage{titlesec,enumitem,fancyhdr}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning}
\RequirePackage{xurl}
\definecolor{researchink}{HTML}{18334A}
\RequirePackage[colorlinks=true,linkcolor=researchink,urlcolor=researchink,citecolor=researchink]{hyperref}
\urlstyle{same}
\setlength{\parindent}{0pt}
\setlength{\parskip}{5pt plus 1pt minus 1pt}
\setlength{\emergencystretch}{3em}
\setlength{\tabcolsep}{5pt}
\renewcommand{\arraystretch}{1.15}
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}
\setlist{nosep,leftmargin=1.5em,topsep=4pt}
\titleformat{\section}{\large\bfseries}{\thesection}{0.7em}{}
\titleformat{\subsection}{\normalsize\bfseries}{\thesubsection}{0.7em}{}
\titlespacing*{\section}{0pt}{14pt}{6pt}
\titlespacing*{\subsection}{0pt}{9pt}{4pt}
\widowpenalty=10000
\clubpenalty=10000
\pagestyle{fancy}
\fancyhf{}
\fancyfoot[C]{\small\thepage}
\renewcommand{\headrulewidth}{0pt}
\setlength{\headheight}{14pt}
\newcommand{\briefheader}[2]{%
  \fancyhead[L]{\small\itshape #1}%
  \fancyhead[R]{\small #2}%
  \renewcommand{\headrulewidth}{0.3pt}}
\newcommand{\brieftitle}[3]{%
  {\centering{\LARGE #1\par}\vspace{4pt}%
  {\large #2\par}\vspace{7pt}{\small #3\par}}\vspace{10pt}}
\tikzset{
  researchbox/.style={draw=researchink,rounded corners=2pt,
    fill=researchink!4,align=center,font=\small,inner sep=7pt},
  researcharrow/.style={-{Stealth[length=2mm]},draw=researchink,thick}}
