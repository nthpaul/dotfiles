#!/usr/bin/env python3
"""Team-scoped worker orchestrator. Cursor steers; Grok (or Cursor) does the work."""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import re
import secrets
import shutil
import signal
import subprocess
import sys
import time
from contextlib import contextmanager
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Iterator, NoReturn

TEAM_RE = re.compile(r"^[a-z][a-z0-9-]{0,31}$")
WORKER_ID_RE = re.compile(r"^w[0-9a-f]{7,8}$")
PANE_OPTION = "@scientist"
TMUX_SESSION = "orch"
TELL_NAMES_PATH = Path.home() / ".cursor" / "skills" / "agent-tell" / "names.txt"
ROSTER_PATH = Path.home() / ".cursor" / "scientists" / "roster.json"
GROK_TELL_MSG = "Grok tell is not v1; use --mode headless"
PUBLIC_COMMANDS = [
    "teams",
    "claim",
    "release",
    "spawn",
    "list",
    "status",
    "logs",
    "result",
    "kill",
    "tell",
    "complete",
    "help",
]
MODES = ("headless", "tell")
KINDS = ("grok", "cursor")

CHEAT_SHEET = """\
Usage:
  orch                         this cheat sheet
  orch help [command]          one command, with examples

  orch teams
  orch claim   --team T
  orch release --team T

  orch spawn --team T [--mode headless|tell] grok|cursor JOB...
             [--cwd DIR] [--name NAME] [--id ID] [--steal]
  orch list   --team T | --all
  orch status --team T ID
  orch logs   --team T ID [-f]
  orch result --team T ID
  orch kill   --team T ID | --team T --all
  orch tell   --team T ID --ask|--status "..."

  orch complete commands|teams|modes|kinds
  orch complete workers --team T

Teams keep workers apart. Spawn starts one. Kill drops it.
Headless writes jobs/<id>/result.json. Tell uses a tmux pane + scientist name.
Grok tell is not v1 — use --mode headless.

Examples:
  orch spawn --team fleet-ops grok fix the login flake
  orch list --team fleet-ops
  orch kill --team fleet-ops w1a2b3c4
  orch tell --team fleet-ops w1a2b3c4 --ask "also check the test"

State: $ORCH_HOME (default ~/.orch)
"""

