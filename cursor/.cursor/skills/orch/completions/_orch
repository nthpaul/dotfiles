#compdef orch

_orch_teams() {
  local -a items
  items=(${(f)"$(command orch complete teams 2>/dev/null)"})
  (( ${#items} )) || return 1
  _describe -t teams 'team' items
}

_orch_workers() {
  local team
  team=$(_orch_team_from_line) || return 1
  local -a items
  items=(${(f)"$(command orch complete workers --team "$team" 2>/dev/null)"})
  (( ${#items} )) || return 1
  _describe -t workers 'worker' items
}

_orch_team_from_line() {
  local i
  for (( i = 1; i < CURRENT; i++ )); do
    if [[ ${words[i]} == --team && -n ${words[i+1]} && ${words[i+1]} != -* ]]; then
      print -r -- ${words[i+1]}
      return 0
    fi
    if [[ ${words[i]} == --team=* && -n ${words[i]#--team=} ]]; then
      print -r -- ${words[i]#--team=}
      return 0
    fi
  done
  return 1
}

_orch_has_kind() {
  local w
  for w in ${words[3,-1]}; do
    [[ $w == grok || $w == cursor ]] && return 0
  done
  return 1
}

_orch_prev_team() {
  [[ ${words[CURRENT-1]} == --team ]] && return 0
  [[ ${words[CURRENT]} == --team=* ]] && return 0
  return 1
}

_orch() {
  local cmd
  cmd=${words[2]}

  if (( CURRENT == 2 )); then
    _alternative \
      'commands:command:((help\:one\ command\ with\ examples teams\:list\ teams claim\:lock\ a\ team release\:unlock\ a\ team spawn\:start\ a\ worker list\:show\ workers status\:one\ worker logs\:job\ logs result\:job\ result kill\:stop\ a\ worker tell\:ask\ or\ status\ a\ tell\ worker complete\:completion\ helpers))' \
      'flags:flag:((-h --help))'
    return
  fi

  if _orch_prev_team; then
    _orch_teams
    return
  fi

  case $cmd in
    -h|--help)
      return
      ;;
    help)
      _values 'command' help teams claim release spawn list status logs result kill tell complete
      ;;
    teams)
      _values 'flag' --help
      ;;
    claim|release)
      _values 'flag' --team --help
      ;;
    spawn)
      if [[ ${words[CURRENT-1]} == --mode ]]; then
        _values 'mode' headless tell
        return
      fi
      if [[ ${words[CURRENT-1]} == --cwd ]]; then
        _files -/
        return
      fi
      if [[ ${words[CURRENT-1]} == --name ]]; then
        _message 'scientist name'
        return
      fi
      if [[ ${words[CURRENT-1]} == --id ]]; then
        _message 'worker id'
        return
      fi
      if _orch_has_kind; then
        _values 'flag' --team --mode --cwd --name --id --steal --help
      else
        _alternative \
          'flags:flag:((--team --mode --cwd --name --id --steal --help))' \
          'kinds:kind:((grok\:Grok\ worker cursor\:Cursor\ worker))'
      fi
      ;;
    list)
      _values 'flag' --team --all --help
      ;;
    status|result)
      _alternative \
        'flags:flag:((--team --help))' \
        'workers:worker:_orch_workers'
      ;;
    logs)
      _alternative \
        'flags:flag:((-f --team --help))' \
        'workers:worker:_orch_workers'
      ;;
    kill)
      _alternative \
        'flags:flag:((--team --all --help))' \
        'workers:worker:_orch_workers'
      ;;
    tell)
      if [[ ${words[CURRENT-1]} == --ask || ${words[CURRENT-1]} == --status ]]; then
        _message 'message'
        return
      fi
      _alternative \
        'flags:flag:((--team --ask --status --help))' \
        'workers:worker:_orch_workers'
      ;;
    complete)
      if (( CURRENT == 3 )); then
        _values 'what' commands teams workers modes kinds
        return
      fi
      if [[ ${words[3]} == workers ]]; then
        _values 'flag' --team
      fi
      ;;
  esac
}

