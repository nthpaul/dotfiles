#!/usr/bin/env bash
# List or clean hanging local agent/dev resources.
# Clean only acts on ids you pass, or --all for that type.
set -euo pipefail

AGENT_IDLE_MIN=30
ONLY=""
WORKTREES_ROOT="${TRABA_WORKTREES_ROOT:-$HOME/.traba/worktrees}"
KNOWN_REPOS=(
  "$HOME/projects/traba/traba"
  "$HOME/projects/traba/the-matrix"
)
SELF_PIDS=""
KILL9=0
FORCE=0
DRY_RUN=0

usage() {
  cat <<'EOF'
Usage:
  hanging-resources [scan] [--only agents|claude|grok|codex|orch|worktrees|hermes|docker|headless] [--agent-idle-min N]

  hanging-resources clean agents|claude|grok|codex|orch|hermes [--all] [--dry-run] [--kill-9] [PID...]
  hanging-resources clean worktrees [--all] [--dry-run] [PATH|repo/slug|slug...]
  hanging-resources clean docker [--all] [--dry-run] [--force] [ID|NAME...]

scan (default) lists leftovers. clean never guesses: pass targets or --all.

  --only headless   grok -p, cursor-agent -p, claude -p, codex exec, orch wrap
                    (any age / CPU — these are background leftovers)
  --all             every item the scan would report for that type
  --dry-run         print what would be removed; do not act
  --kill-9          after TERM, SIGKILL if the pid is still up
  --force           docker: allow removing a running container
                    (docker --all skips running containers unless --force)

Shorthand (same as clean):
  hanging-resources kill PID...
  hanging-resources worktree-remove PATH...
EOF
}

etime_to_min() {
  local e="$1"
  local days=0 rest="$e" hh=0 mm=0 ss=0
  if [[ "$e" == *-* ]]; then
    days="${e%%-*}"
    rest="${e#*-}"
  fi
  local IFS=':'
  # shellcheck disable=SC2086
  set -- $rest
  if [[ $# -eq 3 ]]; then
    hh=$1; mm=$2; ss=$3
  elif [[ $# -eq 2 ]]; then
    mm=$1; ss=$2
  else
    ss=$1
  fi
  echo $(( days * 1440 + 10#$hh * 60 + 10#$mm ))
}

rss_mb() {
  awk -v kb="$1" 'BEGIN { printf "%.0f", kb/1024 }'
}

# pid -> space-separated listen port numbers (TCP LISTEN)
declare -A LISTEN_PORTS=()
declare -A LISTEN_PID_CWD=()
LISTEN_PORTS_LOADED=0
LISTEN_CWDS_LOADED=0

load_listen_ports() {
  (( LISTEN_PORTS_LOADED == 1 )) && return 0
  LISTEN_PORTS_LOADED=1
  local pid="" name port cur
  while IFS= read -r line; do
    case "$line" in
      p*)
        pid="${line#p}"
        ;;
      n*)
        [[ -z "$pid" ]] && continue
        name="${line#n}"
        name="${name%% *}"
        port="${name##*:}"
        port="${port%]}"
        [[ "$port" =~ ^[0-9]+$ ]] || continue
        cur="${LISTEN_PORTS[$pid]:-}"
        if [[ " $cur " != *" $port "* ]]; then
          LISTEN_PORTS[$pid]="${cur:+$cur }$port"
        fi
        ;;
    esac
  done < <(lsof -nP -iTCP -sTCP:LISTEN -F pn 2>/dev/null || true)
}

load_listen_cwds() {
  load_listen_ports
  (( LISTEN_CWDS_LOADED == 1 )) && return 0
  LISTEN_CWDS_LOADED=1
  local pids=("${!LISTEN_PORTS[@]}")
  [[ ${#pids[@]} -eq 0 ]] && return 0
  local csv pid=""
  csv=$(IFS=,; echo "${pids[*]}")
  while IFS= read -r line; do
    case "$line" in
      p*) pid="${line#p}" ;;
      n*) [[ -n "$pid" ]] && LISTEN_PID_CWD[$pid]="${line#n}" ;;
    esac
  done < <(lsof -a -d cwd -p "$csv" -F pn 2>/dev/null || true)
}

collect_descendants() {
  local pid="$1" child
  printf '%s\n' "$pid"
  while IFS= read -r child; do
    [[ -z "$child" ]] && continue
    collect_descendants "$child"
  done < <(pgrep -P "$pid" 2>/dev/null || true)
}

join_ports() {
  if [[ $# -eq 0 ]]; then
    echo "none"
    return 0
  fi
  printf '%s\n' "$@" | sort -n | awk '{ printf "%s%s", sep, $0; sep=", " } END { print "" }'
}

ports_for_pid_tree() {
  load_listen_ports
  local pid="$1" p port
  local -A seen=()
  local ports=()
  while IFS= read -r p; do
    [[ -z "$p" ]] && continue
    for port in ${LISTEN_PORTS[$p]:-}; do
      [[ -n "${seen[$port]+x}" ]] && continue
      seen[$port]=1
      ports+=("$port")
    done
  done < <(collect_descendants "$pid")
  join_ports "${ports[@]+"${ports[@]}"}"
}

ports_for_worktree() {
  load_listen_cwds
  local wt="$1" pid cwd port
  local -A seen=()
  local ports=()
  for pid in "${!LISTEN_PORTS[@]}"; do
    cwd="${LISTEN_PID_CWD[$pid]:-}"
    [[ "$cwd" == "$wt" || "$cwd" == "$wt"/* ]] || continue
    for port in ${LISTEN_PORTS[$pid]}; do
      [[ -n "${seen[$port]+x}" ]] && continue
      seen[$port]=1
      ports+=("$port")
    done
  done
  join_ports "${ports[@]+"${ports[@]}"}"
}

docker_ports_label() {
  local ports="$1"
  if [[ -z "$ports" ]]; then
    echo "ports none"
    return 0
  fi
  echo "ports $ports"
}

want() {
  local kind="$1"
  if [[ -z "$ONLY" || "$ONLY" == "$kind" ]]; then
    return 0
  fi
  if [[ "$ONLY" == "headless" ]]; then
    case "$kind" in
      agents|claude|grok|codex|orch) return 0 ;;
    esac
  fi
  return 1
}

want_idle() {
  [[ "$ONLY" != "headless" ]] && want "$1"
}

collect_self_pids() {
  local p=$$
  while [[ -n "$p" && "$p" != 0 && "$p" != 1 ]]; do
    printf '%s\n' "$p"
    p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ' || true)
    [[ -z "$p" ]] && break
  done
  return 0
}

is_self_pid() {
  local pid="$1"
  grep -qx "$pid" <<<"$SELF_PIDS" || return 1
}

ensure_self_pids() {
  [[ -n "$SELF_PIDS" ]] && return 0
  SELF_PIDS=$(collect_self_pids)
}

cmd_is_kind() {
  local kind="$1" cmd="$2"
  local exe="${cmd%% *}"
  case "$kind" in
    agents)
      [[ "$cmd" == *worker-server* ]] && return 1
      [[ "$exe" == "cursor-agent" || "$exe" == */cursor-agent || "$cmd" == */cursor-agent* ]] && return 0
      [[ "$cmd" == */.local/share/cursor-agent/* ]] && return 0
      # PATH symlink / exec -a "$0" when invoked as `agent`
      [[ "$exe" == "agent" || "$exe" == */.local/bin/agent ]]
      ;;
    claude)
      [[ "$cmd" == *slack-code-bridge* ]] && return 1
      [[ "$exe" == *Claude.app* || "$exe" == *ClaudeCode.app* || "$exe" == *"Claude Code.app"* ]] && return 1
      [[ "$exe" == "claude" || "$exe" == */claude || "$exe" == *"/.local/share/claude/versions/"* ]]
      ;;
    grok)
      [[ "$cmd" == *"/Grok Bot.app/"* ]] && return 1
      [[ "$exe" == "grok" || "$exe" == */grok || "$exe" == */.grok/bin/agent || "$exe" == *grok-macos* ]] && return 0
      [[ "$exe" == *"/.grok/downloads/grok-"* ]]
      ;;
    codex)
      [[ "$cmd" == *"/Codex.app/"* ]] && return 1
      [[ "$cmd" == *"codex sandbox"* || "$cmd" == *node_repl* || "$cmd" == */codex.js* ]] && return 0
      [[ "$exe" == "codex" || "$exe" == */codex ]]
      ;;
    orch)
      [[ "$cmd" == *" orch __wrap "* || "$cmd" == *"/orch __wrap "* || "$cmd" == *" orch __wrap" ]]
      ;;
    hermes)
      [[ "$cmd" == *hermes_cli.main* && "$cmd" == *"gateway restart"* ]]
      ;;
    *)
      return 1
      ;;
  esac
}

# Flag tokens before the first positional. Interactive `grok "fix -p x"` is not headless.
is_headless_cmd() {
  local kind="$1" cmd="$2"
  local -a toks=()
  local i=1 n tok next
  [[ -n "$cmd" ]] || return 1
  if [[ "$kind" == orch ]]; then
    return 0
  fi
  read -r -a toks <<<"$cmd"
  n=${#toks[@]}
  (( n > 1 )) || return 1
  while (( i < n )); do
    tok="${toks[i]}"
    if [[ "$tok" == "--" ]]; then
      return 1
    fi
    if [[ "$tok" == -* ]]; then
      case "$tok" in
        -p|--print|--single|--prompt-json|--prompt-file|--single=*|--prompt-json=*|--prompt-file=*|--print=*)
          return 0
          ;;
      esac
      if [[ "$tok" == *=* ]]; then
        i=$((i + 1))
        continue
      fi
      next="${toks[i+1]:-}"
      if [[ -n "$next" && "$next" != -* ]]; then
        i=$((i + 2))
      else
        i=$((i + 1))
      fi
      continue
    fi
    case "$kind" in
      grok)
        if [[ "$tok" == "agent" ]]; then
          next="${toks[i+1]:-}"
          case "$next" in
            headless|stdio|serve) return 0 ;;
          esac
        fi
        ;;
      codex)
        if [[ "$tok" == "exec" || "$tok" == "e" ]]; then
          return 0
        fi
        ;;
    esac
    return 1
  done
  return 1
}

idle_min_for() {
  local kind="$1" cmd="$2"
  if [[ "$kind" == codex && ( "$cmd" == *"codex sandbox"* || "$cmd" == *node_repl* ) ]]; then
    echo 60
  else
    echo "$AGENT_IDLE_MIN"
  fi
}

process_label() {
  local kind="$1" cmd="$2"
  case "$kind" in
    agents)
      if is_headless_cmd agents "$cmd"; then
        echo "cursor-agent -p"
      else
        echo "cursor-agent"
      fi
      ;;
    claude)
      if is_headless_cmd claude "$cmd"; then
        echo "claude -p"
      else
        echo "claude"
      fi
      ;;
    grok)
      if [[ "$cmd" == *" agent headless"* ]]; then
        echo "grok agent headless"
      elif [[ "$cmd" == *" agent stdio"* ]]; then
        echo "grok agent stdio"
      elif is_headless_cmd grok "$cmd"; then
        echo "grok -p"
      else
        echo "grok"
      fi
      ;;
    codex)
      if [[ "$cmd" == *node_repl* ]]; then
        echo "codex node_repl"
      elif [[ "$cmd" == *"codex sandbox"* ]]; then
        echo "codex sandbox"
      elif is_headless_cmd codex "$cmd"; then
        echo "codex exec"
      else
        echo "codex"
      fi
      ;;
    orch) echo "orch wrap" ;;
    *) echo "$kind" ;;
  esac
}

# pid, etime, cpu, rss, cmd — one row per matching process
each_kind_row() {
  local kind="$1"
  local pid ppid etime cpu rss cmd
  while read -r pid ppid etime cpu rss cmd; do
    [[ "$pid" =~ ^[0-9]+$ ]] || continue
    [[ -n "$cmd" ]] || continue
    cmd_is_kind "$kind" "$cmd" || continue
    printf '%s\t%s\t%s\t%s\t%s\n' "$pid" "$etime" "$cpu" "$rss" "$cmd"
  done < <(ps -ax -o pid=,ppid=,etime=,%cpu=,rss=,command= 2>/dev/null)
}

row_is_hanging() {
  local kind="$1" etime="$2" cpu="$3" cmd="$4"
  local mins cpu_int need
  if is_headless_cmd "$kind" "$cmd"; then
    return 0
  fi
  mins=$(etime_to_min "$etime")
  cpu_int=${cpu%.*}
  need=$(idle_min_for "$kind" "$cmd")
  (( mins >= need )) && (( cpu_int <= 1 ))
}

list_kind_pids() {
  local kind="$1"
  ensure_self_pids
  local pid etime cpu rss cmd
  while IFS=$'\t' read -r pid etime cpu rss cmd; do
    [[ -z "$pid" ]] && continue
    is_self_pid "$pid" && continue
    row_is_hanging "$kind" "$etime" "$cpu" "$cmd" || continue
    printf '%s\n' "$pid"
  done < <(each_kind_row "$kind")
  return 0
}

# --- discovery (one id per line) ---

list_agent_pids() { list_kind_pids agents; }
list_claude_pids() { list_kind_pids claude; }
list_grok_pids() { list_kind_pids grok; }
list_codex_pids() { list_kind_pids codex; }
list_orch_pids() { list_kind_pids orch; }

list_hermes_pids() {
  local pid etime cpu rss cmd
  while IFS=$'\t' read -r pid etime cpu rss cmd; do
    [[ -z "$pid" ]] && continue
    printf '%s\n' "$pid"
  done < <(each_kind_row hermes)
  return 0
}

list_worktree_paths() {
  declare -A seen=()
  local repo wt_line path
  for repo in "${KNOWN_REPOS[@]}"; do
    [[ -d "$repo/.git" || -f "$repo/.git" ]] || continue
    while IFS= read -r wt_line; do
      [[ -z "$wt_line" ]] && continue
      path=$(awk '{print $1}' <<<"$wt_line")
      [[ "$path" == "$repo" ]] && continue
      [[ -n "${seen[$path]+x}" ]] && continue
      seen[$path]=1
      printf '%s\n' "$path"
    done < <(git -C "$repo" worktree list 2>/dev/null || true)
  done
  if [[ -d "$WORKTREES_ROOT" ]]; then
    while IFS= read -r path; do
      [[ -z "$path" ]] && continue
      [[ -n "${seen[$path]+x}" ]] && continue
      printf '%s\n' "$path"
    done < <(find "$WORKTREES_ROOT" -mindepth 2 -maxdepth 2 -type d 2>/dev/null || true)
  fi
  return 0
}

list_docker_rows() {
  if ! docker info >/dev/null 2>&1; then
    return 0
  fi
  docker ps -a --format '{{.ID}}\t{{.Status}}\t{{.Names}}\t{{.Image}}\t{{.Ports}}' 2>/dev/null || true
}

list_docker_ids() {
  local exited_only="${1:-0}"
  local id status
  while IFS=$'\t' read -r id status _ _ _; do
    [[ -z "$id" ]] && continue
    if [[ "$exited_only" == "1" && "$status" != Exited* && "$status" != Created* && "$status" != Dead* ]]; then
      continue
    fi
    printf '%s\n' "$id"
  done < <(list_docker_rows)
  return 0
}

pid_command() {
  ps -p "$1" -o command= 2>/dev/null || true
}

assert_pid_kind() {
  local kind="$1" pid="$2"
  local cmd short
  [[ "$kind" == any ]] && return 0
  cmd=$(pid_command "$pid")
  [[ -n "$cmd" ]] || return 0
  cmd_is_kind "$kind" "$cmd" && return 0
  short="$cmd"
  (( ${#short} > 120 )) && short="${short:0:120}…"
  echo "pid $pid is not $kind: $short" >&2
  return 1
}

# --- scan ---

cmd_scan() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --only)
        ONLY="${2:-}"
        case "$ONLY" in
          agents|claude|grok|codex|orch|hermes|worktrees|docker|headless) ;;
          *)
            echo "Unknown type: $ONLY" >&2
            usage >&2
            exit 2
            ;;
        esac
        shift 2
        ;;
      --agent-idle-min)
        AGENT_IDLE_MIN="${2:-30}"
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        echo "Unknown arg: $1" >&2
        usage >&2
        exit 2
        ;;
    esac
  done

  ensure_self_pids
  load_listen_ports
  if want worktrees; then
    load_listen_cwds
  fi
  local findings=0 found pid etime cpu rss mb cwd cmd label wd path branch repo row id status names image
  emit() {
    findings=$((findings + 1))
    printf '%s\n' "$1"
  }
  section() {
    printf '\n## %s\n' "$1"
  }
  emit_proc() {
    local kind="$1" pid="$2" etime="$3" cpu="$4" rss="$5" cmd="$6"
    local cwd mb
    cwd=$(lsof -a -d cwd -p "$pid" 2>/dev/null | awk 'NR==2 {print $NF}')
    mb=$(rss_mb "$rss")
    emit "- pid $pid · age $etime · cpu ${cpu}% · ~${mb}MB · ports $(ports_for_pid_tree "$pid") · $(process_label "$kind" "$cmd") · cwd ${cwd:-?}"
  }

  scan_kind_mode() {
    local kind="$1" title="$2" mode="$3"
    local pid etime cpu rss cmd
    local print_empty=1 header_printed=0
    if [[ -z "$ONLY" && "$mode" == "headless" ]]; then
      print_empty=0
    fi
    found=0
    while IFS=$'\t' read -r pid etime cpu rss cmd; do
      [[ -z "$pid" ]] && continue
      is_self_pid "$pid" && continue
      if [[ "$mode" == "headless" ]]; then
        is_headless_cmd "$kind" "$cmd" || continue
      else
        is_headless_cmd "$kind" "$cmd" && continue
        row_is_hanging "$kind" "$etime" "$cpu" "$cmd" || continue
      fi
      if (( header_printed == 0 )); then
        section "$title"
        header_printed=1
      fi
      emit_proc "$kind" "$pid" "$etime" "$cpu" "$rss" "$cmd"
      found=1
    done < <(each_kind_row "$kind")
    if (( found == 0 && print_empty == 1 )); then
      section "$title"
      echo "(none)"
    fi
  }

  if want agents; then
    if want_idle agents; then
      scan_kind_mode agents "Idle cursor-agent" idle
    fi
    scan_kind_mode agents "Headless cursor-agent" headless
  fi

  if want claude; then
    if want_idle claude; then
      scan_kind_mode claude "Idle Claude" idle
    fi
    scan_kind_mode claude "Headless Claude" headless
  fi

  if want grok; then
    if want_idle grok; then
      scan_kind_mode grok "Idle Grok" idle
    fi
    scan_kind_mode grok "Headless Grok" headless
  fi

  if want orch; then
    scan_kind_mode orch "Orch wrappers" headless
  fi

  if want hermes; then
    section "Stuck Hermes gateway"
    found=0
    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      pid=$(awk '{print $1}' <<<"$line")
      etime=$(awk '{print $2}' <<<"$line")
      cpu=$(awk '{print $3}' <<<"$line")
      rss=$(awk '{print $4}' <<<"$line")
      mb=$(rss_mb "$rss")
      emit "- pid $pid · age $etime · cpu ${cpu}% · ~${mb}MB · ports $(ports_for_pid_tree "$pid") · hermes_cli.main gateway restart"
      found=1
    done < <(ps -ax -o pid=,etime=,%cpu=,rss=,command= \
      | awk '/hermes_cli\.main gateway restart/ && $0 !~ /awk/ {print}')
    if (( found == 0 )); then
      echo "(none)"
    fi
  fi

  if want codex; then
    if want_idle codex; then
      scan_kind_mode codex "Idle Codex" idle
    fi
    scan_kind_mode codex "Headless Codex" headless
  fi

  if want worktrees; then
    section "Leftover worktrees"
    found=0
    declare -A seen=()
    for repo in "${KNOWN_REPOS[@]}"; do
      [[ -d "$repo/.git" || -f "$repo/.git" ]] || continue
      while IFS= read -r wt_line; do
        [[ -z "$wt_line" ]] && continue
        path=$(awk '{print $1}' <<<"$wt_line")
        [[ "$path" == "$repo" ]] && continue
        [[ -n "${seen[$path]+x}" ]] && continue
        seen[$path]=1
        branch=$(sed -n 's/.*\[\([^]]*\)\].*/\1/p' <<<"$wt_line")
        emit "- $path${branch:+ · [$branch]} · ports $(ports_for_worktree "$path") · from $(basename "$repo")"
        found=1
      done < <(git -C "$repo" worktree list 2>/dev/null || true)
    done
    if [[ -d "$WORKTREES_ROOT" ]]; then
      while IFS= read -r path; do
        [[ -z "$path" ]] && continue
        [[ -n "${seen[$path]+x}" ]] && continue
        emit "- $path · ports $(ports_for_worktree "$path") · (dir present, not in git worktree list)"
        found=1
      done < <(find "$WORKTREES_ROOT" -mindepth 2 -maxdepth 2 -type d 2>/dev/null || true)
    fi
    if (( found == 0 )); then
      echo "(none)"
    fi
  fi

  if want docker; then
    section "Docker"
    if ! docker info >/dev/null 2>&1; then
      echo "(daemon not running)"
    else
      found=0
      local ports
      while IFS=$'\t' read -r id status names image ports; do
        [[ -z "$id" ]] && continue
        emit "- $id  $status  $names  $image  $(docker_ports_label "$ports")"
        found=1
      done < <(list_docker_rows)
      if (( found == 0 )); then
        echo "(none)"
      fi
    fi
  fi

  printf '\n---\n'
  if (( findings == 0 )); then
    echo "Verdict: clean"
  else
    echo "Verdict: $findings hanging item(s)"
  fi
}

# --- clean ---

kill_pids() {
  local kind="$1"
  shift
  local pid still=()
  [[ $# -gt 0 ]] || return 0
  for pid in "$@"; do
    if [[ ! "$pid" =~ ^[0-9]+$ ]]; then
      echo "Not a PID: $pid" >&2
      exit 2
    fi
    if is_self_pid "$pid"; then
      echo "pid $pid: refusing to kill this session" >&2
      exit 2
    fi
    if ! kill -0 "$pid" 2>/dev/null; then
      echo "pid $pid: already gone"
      continue
    fi
    assert_pid_kind "$kind" "$pid"
    if (( DRY_RUN == 1 )); then
      echo "would kill pid $pid"
      continue
    fi
    kill "$pid"
    echo "pid $pid: sent TERM"
    still+=("$pid")
  done
  [[ ${#still[@]} -eq 0 ]] && return 0
  sleep 2
  local leftover=()
  for pid in "${still[@]}"; do
    if kill -0 "$pid" 2>/dev/null; then
      leftover+=("$pid")
    else
      echo "pid $pid: gone"
    fi
  done
  if [[ ${#leftover[@]} -eq 0 ]]; then
    return 0
  fi
  if (( KILL9 == 1 )); then
    for pid in "${leftover[@]}"; do
      kill -9 "$pid" 2>/dev/null || true
      echo "pid $pid: sent KILL"
    done
    sleep 1
    for pid in "${leftover[@]}"; do
      if kill -0 "$pid" 2>/dev/null; then
        echo "pid $pid: still alive after KILL" >&2
      else
        echo "pid $pid: gone"
      fi
    done
  else
    for pid in "${leftover[@]}"; do
      echo "pid $pid: still alive (pass --kill-9)"
    done
  fi
}

resolve_worktrees() {
  local spec="$1"
  local expanded matches=()
  expanded="${spec/#\~/$HOME}"
  if [[ -e "$expanded" ]]; then
    printf '%s\n' "$expanded"
    return 0
  fi
  if [[ "$spec" == */* && "$spec" != /* ]]; then
    expanded="$WORKTREES_ROOT/$spec"
    if [[ -e "$expanded" ]]; then
      printf '%s\n' "$expanded"
      return 0
    fi
  fi
  while IFS= read -r path; do
    [[ -z "$path" ]] && continue
    if [[ "$(basename "$path")" == "$spec" || "$path" == *"$spec" ]]; then
      matches+=("$path")
    fi
  done < <(list_worktree_paths)
  if [[ ${#matches[@]} -eq 0 ]]; then
    echo "no worktree matches: $spec" >&2
    return 1
  fi
  printf '%s\n' "${matches[@]}"
}

remove_worktree() {
  local path="$1"
  local common repo rel
  if [[ ! -e "$path" ]]; then
    echo "missing: $path" >&2
    return 1
  fi
  if (( DRY_RUN == 1 )); then
    echo "would remove worktree: $path"
    return 0
  fi
  common=$(git -C "$path" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
  if [[ -n "$common" ]]; then
    repo="${common%.git}"
    repo="${repo%/}"
    git -C "$repo" worktree remove --force "$path"
    git -C "$repo" worktree prune
    echo "removed worktree: $path"
    return 0
  fi
  rel="${path#"$WORKTREES_ROOT"/}"
  if [[ "$path" == "$WORKTREES_ROOT"/* && "$rel" != */*/* && "$rel" == */* ]]; then
    rm -rf "$path"
    echo "removed leftover dir: $path"
    return 0
  fi
  echo "not a git worktree and not under $WORKTREES_ROOT/<repo>/<slug>: $path" >&2
  return 1
}

resolve_docker() {
  local spec="$1"
  local id status names image ports
  while IFS=$'\t' read -r id status names image ports; do
    [[ -z "$id" ]] && continue
    if [[ "$id" == "$spec"* || "$names" == "$spec" ]]; then
      printf '%s\t%s\t%s\n' "$id" "$status" "$names"
      return 0
    fi
  done < <(list_docker_rows)
  echo "no docker container matches: $spec" >&2
  return 1
}

remove_docker() {
  local spec="$1"
  local id status names image
  IFS=$'\t' read -r id status names image < <(resolve_docker "$spec")
  [[ -n "$id" ]] || return 1
  if [[ "$status" == Up* ]]; then
    if (( FORCE != 1 )); then
      echo "running: $names ($id) — pass --force to remove" >&2
      return 1
    fi
    if (( DRY_RUN == 1 )); then
      echo "would remove running: $names ($id)"
      return 0
    fi
    docker rm -f "$id" >/dev/null
    echo "removed running: $names ($id)"
  else
    if (( DRY_RUN == 1 )); then
      echo "would remove: $names ($id)"
      return 0
    fi
    docker rm "$id" >/dev/null
    echo "removed: $names ($id)"
  fi
}

cmd_clean() {
  if [[ $# -lt 1 ]]; then
    echo "hanging-resources clean: pass a type (agents|claude|grok|codex|orch|hermes|worktrees|docker)" >&2
    usage >&2
    exit 2
  fi
  local kind="$1"
  shift
  local all=0
  local targets=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all) all=1; shift ;;
      --dry-run) DRY_RUN=1; shift ;;
      --kill-9) KILL9=1; shift ;;
      --force) FORCE=1; shift ;;
      -h|--help) usage; exit 0 ;;
      --*) echo "Unknown flag: $1" >&2; usage >&2; exit 2 ;;
      *) targets+=("$1"); shift ;;
    esac
  done

  case "$kind" in
    agents|claude|grok|codex|orch|hermes|worktrees|docker) ;;
    *)
      echo "Unknown type: $kind" >&2
      usage >&2
      exit 2
      ;;
  esac

  if (( all == 0 )) && [[ ${#targets[@]} -eq 0 ]]; then
    echo "clean $kind: pass PIDs/paths/names, or --all" >&2
    exit 2
  fi
  if (( all == 1 )) && [[ ${#targets[@]} -gt 0 ]]; then
    echo "clean $kind: use --all or targets, not both" >&2
    exit 2
  fi

  ensure_self_pids
  local ids=() spec path

  case "$kind" in
    agents|claude|grok|codex|orch|hermes)
      if (( all == 1 )); then
        case "$kind" in
          hermes) mapfile -t ids < <(list_hermes_pids) ;;
          *) mapfile -t ids < <(list_kind_pids "$kind") ;;
        esac
        if [[ ${#ids[@]} -eq 0 ]]; then
          echo "clean $kind: nothing to kill"
          return 0
        fi
        echo "clean $kind --all: ${ids[*]}"
      else
        ids=("${targets[@]}")
      fi
      kill_pids "$kind" "${ids[@]}"
      ;;
    worktrees)
      if (( all == 1 )); then
        mapfile -t ids < <(list_worktree_paths)
        if [[ ${#ids[@]} -eq 0 ]]; then
          echo "clean worktrees: nothing to remove"
          return 0
        fi
        echo "clean worktrees --all: ${#ids[@]} path(s) (node_modules can make this slow)"
      else
        ids=()
        for spec in "${targets[@]}"; do
          while IFS= read -r path; do
            ids+=("$path")
          done < <(resolve_worktrees "$spec")
        done
      fi
      for path in "${ids[@]}"; do
        remove_worktree "$path"
      done
      ;;
    docker)
      if (( all == 1 )); then
        # --all never touches running containers unless --force.
        if (( FORCE == 1 )); then
          mapfile -t ids < <(list_docker_ids 0)
        else
          mapfile -t ids < <(list_docker_ids 1)
        fi
        if [[ ${#ids[@]} -eq 0 ]]; then
          echo "clean docker: nothing to remove"
          return 0
        fi
        echo "clean docker --all: ${#ids[@]} container(s)"
        for spec in "${ids[@]}"; do
          remove_docker "$spec"
        done
      else
        for spec in "${targets[@]}"; do
          remove_docker "$spec"
        done
      fi
      ;;
  esac
}

cmd_kill() {
  local targets=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --kill-9) KILL9=1; shift ;;
      --dry-run) DRY_RUN=1; shift ;;
      *) targets+=("$1"); shift ;;
    esac
  done
  if [[ ${#targets[@]} -eq 0 ]]; then
    echo "hanging-resources kill: pass one or more PIDs" >&2
    exit 2
  fi
  ensure_self_pids
  kill_pids any "${targets[@]}"
}

cmd_worktree_remove() {
  if [[ $# -eq 0 ]]; then
    echo "hanging-resources worktree-remove: pass one or more paths or slugs" >&2
    exit 2
  fi
  local spec path
  for spec in "$@"; do
    while IFS= read -r path; do
      remove_worktree "$path"
    done < <(resolve_worktrees "$spec")
  done
}

cmd_complete() {
  ensure_self_pids
  case "${1:-}" in
    agents) list_agent_pids ;;
    claude) list_claude_pids ;;
    grok) list_grok_pids ;;
    orch) list_orch_pids ;;
    hermes) list_hermes_pids ;;
    codex) list_codex_pids ;;
    kill)
      list_agent_pids
      list_claude_pids
      list_grok_pids
      list_orch_pids
      list_hermes_pids
      list_codex_pids
      ;;
    worktrees)
      local path slug repo
      while IFS= read -r path; do
        [[ -z "$path" ]] && continue
        slug=$(basename "$path")
        repo=$(basename "$(dirname "$path")")
        printf '%s\n' "$slug"
        printf '%s\n' "$repo/$slug"
        printf '%s\n' "$path"
      done < <(list_worktree_paths)
      ;;
    docker)
      local id status names image ports
      while IFS=$'\t' read -r id status names image ports; do
        [[ -z "$id" ]] && continue
        printf '%s\n' "$names"
        printf '%s\n' "$id"
      done < <(list_docker_rows)
      ;;
    *)
      echo "hanging-resources complete: agents|claude|grok|orch|hermes|codex|worktrees|docker|kill" >&2
      exit 2
      ;;
  esac
}

cmd_self_test() {
  local fails=0
  expect() {
    local name="$1" got="$2" want="$3"
    if [[ "$got" != "$want" ]]; then
      echo "FAIL $name: got $got want $want" >&2
      fails=$((fails + 1))
    fi
  }
  expect_kind() {
    local kind="$1" cmd="$2" want="$3"
    if cmd_is_kind "$kind" "$cmd"; then
      expect "kind $kind :: $cmd" 1 "$want"
    else
      expect "kind $kind :: $cmd" 0 "$want"
    fi
  }
  expect_headless() {
    local kind="$1" cmd="$2" want="$3"
    if is_headless_cmd "$kind" "$cmd"; then
      expect "headless $kind :: $cmd" 1 "$want"
    else
      expect "headless $kind :: $cmd" 0 "$want"
    fi
  }

  expect_kind grok "/Users/ple/.grok/bin/grok -p do the thing" 1
  expect_kind grok "grok" 1
  expect_kind grok "/Applications/Grok Bot.app/Contents/MacOS/Grok Bot" 0
  expect_kind grok "/Users/ple/.grok/downloads/grok-1.0.13-macos-aarch64 -p hi" 1
  expect_kind agents "/Users/ple/.local/bin/cursor-agent -p --force --trust --workspace /tmp hi" 1
  expect_kind agents "cursor-agent -p hi" 1
  expect_kind agents "agent -p --force hi" 1
  expect_kind agents "/Users/ple/.local/share/cursor-agent/versions/x/index.js -p hi" 1
  expect_kind agents "cursor-agent --workspace /tmp worker-server" 0
  expect_kind claude "claude -p do it" 1
  expect_kind claude "/Users/ple/.local/share/claude/versions/2.1.153 -p hi" 1
  expect_kind orch "/Library/Frameworks/Python.framework/Versions/3.12/Resources/Python.app/Contents/MacOS/Python /Users/ple/.dotfiles/cursor/.cursor/skills/orch/scripts/orch __wrap --team shift-manager --id w0fea1d1c" 1
  expect_kind orch "python3 orch list --team x" 0
  expect_kind codex "codex exec fix the bug" 1

  expect_headless grok "/Users/ple/.grok/bin/grok -p ORCH_TEAM=x do the thing" 1
  expect_headless grok "grok --cwd /tmp -p do the thing --always-approve" 1
  expect_headless grok "grok" 0
  expect_headless grok "grok fix -p the bug" 0
  expect_headless grok "grok agent headless --grok-ws-url wss://x" 1
  expect_headless grok "grok agent stdio" 1
  expect_headless grok "grok --prompt-file /tmp/p.md" 1
  expect_headless agents "cursor-agent -p --force --trust --workspace /tmp hi" 1
  expect_headless agents "cursor-agent --force --trust --workspace /tmp hi" 0
  expect_headless claude "claude -p hello" 1
  expect_headless claude "claude --print hello" 1
  expect_headless claude "claude" 0
  expect_headless codex "codex exec fix it" 1
  expect_headless codex "codex" 0
  expect_headless orch "python3 /x/orch __wrap --team t --id w1" 1

  if (( fails > 0 )); then
    echo "self-test: $fails failed" >&2
    exit 1
  fi
  echo "self-test: ok"
}

main() {
  local sub="scan"
  if [[ $# -gt 0 ]]; then
    case "$1" in
      scan|clean|kill|worktree-remove|complete|self-test)
        sub=$1
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      -*)
        sub=scan
        ;;
      *)
        echo "Unknown command: $1" >&2
        usage >&2
        exit 2
        ;;
    esac
  fi
  case "$sub" in
    scan) cmd_scan "$@" ;;
    clean) cmd_clean "$@" ;;
    kill) cmd_kill "$@" ;;
    worktree-remove) cmd_worktree_remove "$@" ;;
    complete) cmd_complete "$@" ;;
    self-test) cmd_self_test "$@" ;;
  esac
}

main "$@"
