#!/usr/bin/env bash
# List or clean hanging local agent/dev resources.
# Clean only acts on ids you pass, or --all for that type.
set -euo pipefail

AGENT_IDLE_MIN=30
ONLY=""
WORKTREES_ROOT="${TRABA_WORKTREES_ROOT:-$HOME/.traba/worktrees}"
KNOWN_REPOS=(
  "$HOME/projects/traba/traba"
  "$HOME/projects/traba/the-matrix"
)
SELF_PIDS=""
KILL9=0
FORCE=0
DRY_RUN=0

usage() {
  cat <<'EOF'
Usage:
  hanging-resources [scan] [--only agents|worktrees|hermes|codex|docker] [--agent-idle-min N]

  hanging-resources clean agents|hermes|codex [--all] [--dry-run] [--kill-9] [PID...]
  hanging-resources clean worktrees [--all] [--dry-run] [PATH|repo/slug|slug...]
  hanging-resources clean docker [--all] [--dry-run] [--force] [ID|NAME...]

scan (default) lists leftovers. clean never guesses: pass targets or --all.

  --all       every item the scan would report for that type
  --dry-run   print what would be removed; do not act
  --kill-9    after TERM, SIGKILL if the pid is still up
  --force     docker: allow removing a running container
              (docker --all skips running containers unless --force)

Shorthand (same as clean):
  hanging-resources kill PID...
  hanging-resources worktree-remove PATH...
EOF
}

etime_to_min() {
  local e="$1"
  local days=0 rest="$e" hh=0 mm=0 ss=0
  if [[ "$e" == *-* ]]; then
    days="${e%%-*}"
    rest="${e#*-}"
  fi
  local IFS=':'
  # shellcheck disable=SC2086
  set -- $rest
  if [[ $# -eq 3 ]]; then
    hh=$1; mm=$2; ss=$3
  elif [[ $# -eq 2 ]]; then
    mm=$1; ss=$2
  else
    ss=$1
  fi
  echo $(( days * 1440 + 10#$hh * 60 + 10#$mm ))
}

rss_mb() {
  awk -v kb="$1" 'BEGIN { printf "%.0f", kb/1024 }'
}

# pid -> space-separated listen port numbers (TCP LISTEN)
declare -A LISTEN_PORTS=()
declare -A LISTEN_PID_CWD=()
LISTEN_PORTS_LOADED=0
LISTEN_CWDS_LOADED=0

load_listen_ports() {
  (( LISTEN_PORTS_LOADED == 1 )) && return 0
  LISTEN_PORTS_LOADED=1
  local pid="" name port cur
  while IFS= read -r line; do
    case "$line" in
      p*)
        pid="${line#p}"
        ;;
      n*)
        [[ -z "$pid" ]] && continue
        name="${line#n}"
        name="${name%% *}"
        port="${name##*:}"
        port="${port%]}"
        [[ "$port" =~ ^[0-9]+$ ]] || continue
        cur="${LISTEN_PORTS[$pid]:-}"
        if [[ " $cur " != *" $port "* ]]; then
          LISTEN_PORTS[$pid]="${cur:+$cur }$port"
        fi
        ;;
    esac
  done < <(lsof -nP -iTCP -sTCP:LISTEN -F pn 2>/dev/null || true)
}

load_listen_cwds() {
  load_listen_ports
  (( LISTEN_CWDS_LOADED == 1 )) && return 0
  LISTEN_CWDS_LOADED=1
  local pids=("${!LISTEN_PORTS[@]}")
  [[ ${#pids[@]} -eq 0 ]] && return 0
  local csv pid=""
  csv=$(IFS=,; echo "${pids[*]}")
  while IFS= read -r line; do
    case "$line" in
      p*) pid="${line#p}" ;;
      n*) [[ -n "$pid" ]] && LISTEN_PID_CWD[$pid]="${line#n}" ;;
    esac
  done < <(lsof -a -d cwd -p "$csv" -F pn 2>/dev/null || true)
}

collect_descendants() {
  local pid="$1" child
  printf '%s\n' "$pid"
  while IFS= read -r child; do
    [[ -z "$child" ]] && continue
    collect_descendants "$child"
  done < <(pgrep -P "$pid" 2>/dev/null || true)
}

join_ports() {
  if [[ $# -eq 0 ]]; then
    echo "none"
    return 0
  fi
  printf '%s\n' "$@" | sort -n | awk '{ printf "%s%s", sep, $0; sep=", " } END { print "" }'
}

ports_for_pid_tree() {
  load_listen_ports
  local pid="$1" p port
  local -A seen=()
  local ports=()
  while IFS= read -r p; do
    [[ -z "$p" ]] && continue
    for port in ${LISTEN_PORTS[$p]:-}; do
      [[ -n "${seen[$port]+x}" ]] && continue
      seen[$port]=1
      ports+=("$port")
    done
  done < <(collect_descendants "$pid")
  join_ports "${ports[@]+"${ports[@]}"}"
}

ports_for_worktree() {
  load_listen_cwds
  local wt="$1" pid cwd port
  local -A seen=()
  local ports=()
  for pid in "${!LISTEN_PORTS[@]}"; do
    cwd="${LISTEN_PID_CWD[$pid]:-}"
    [[ "$cwd" == "$wt" || "$cwd" == "$wt"/* ]] || continue
    for port in ${LISTEN_PORTS[$pid]}; do
      [[ -n "${seen[$port]+x}" ]] && continue
      seen[$port]=1
      ports+=("$port")
    done
  done
  join_ports "${ports[@]+"${ports[@]}"}"
}

docker_ports_label() {
  local ports="$1"
  if [[ -z "$ports" ]]; then
    echo "ports none"
    return 0
  fi
  echo "ports $ports"
}

want() {
  [[ -z "$ONLY" || "$ONLY" == "$1" ]]
}

collect_self_pids() {
  local p=$$
  while [[ -n "$p" && "$p" != 0 && "$p" != 1 ]]; do
    printf '%s\n' "$p"
    p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ' || true)
    [[ -z "$p" ]] && break
  done
  return 0
}

is_self_pid() {
  local pid="$1"
  grep -qx "$pid" <<<"$SELF_PIDS" || return 1
}

ensure_self_pids() {
  [[ -n "$SELF_PIDS" ]] && return 0
  SELF_PIDS=$(collect_self_pids)
}

# --- discovery (one id per line) ---

list_agent_pids() {
  ensure_self_pids
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    local pid etime cpu mins cpu_int
    pid=$(awk '{print $1}' <<<"$line")
    is_self_pid "$pid" && continue
    etime=$(awk '{print $3}' <<<"$line")
    cpu=$(awk '{print $4}' <<<"$line")
    mins=$(etime_to_min "$etime")
    cpu_int=${cpu%.*}
    (( mins < AGENT_IDLE_MIN )) && continue
    (( cpu_int > 1 )) && continue
    printf '%s\n' "$pid"
  done < <(ps -ax -o pid=,ppid=,etime=,%cpu=,rss=,command= \
    | awk '/\/cursor-agent( |$)/ && $0 !~ /worker-server/ && $0 !~ /awk/ {print}')
  return 0
}

list_hermes_pids() {
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    awk '{print $1}' <<<"$line"
  done < <(ps -ax -o pid=,etime=,%cpu=,rss=,command= \
    | awk '/hermes_cli\.main gateway restart/ && $0 !~ /awk/ {print}')
  return 0
}

list_codex_pids() {
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    local pid etime cpu mins cpu_int
    pid=$(awk '{print $1}' <<<"$line")
    etime=$(awk '{print $2}' <<<"$line")
    cpu=$(awk '{print $3}' <<<"$line")
    mins=$(etime_to_min "$etime")
    cpu_int=${cpu%.*}
    (( mins < 60 || cpu_int > 1 )) && continue
    printf '%s\n' "$pid"
  done < <(ps -ax -o pid=,etime=,%cpu=,rss=,command= \
    | awk '/codex sandbox|cua_node\/bin\/node_repl/ && $0 !~ /awk/ {print}')
  return 0
}

list_worktree_paths() {
  declare -A seen=()
  local repo wt_line path
  for repo in "${KNOWN_REPOS[@]}"; do
    [[ -d "$repo/.git" || -f "$repo/.git" ]] || continue
    while IFS= read -r wt_line; do
      [[ -z "$wt_line" ]] && continue
      path=$(awk '{print $1}' <<<"$wt_line")
      [[ "$path" == "$repo" ]] && continue
      [[ -n "${seen[$path]+x}" ]] && continue
      seen[$path]=1
      printf '%s\n' "$path"
    done < <(git -C "$repo" worktree list 2>/dev/null || true)
  done
  if [[ -d "$WORKTREES_ROOT" ]]; then
    while IFS= read -r path; do
      [[ -z "$path" ]] && continue
      [[ -n "${seen[$path]+x}" ]] && continue
      printf '%s\n' "$path"
    done < <(find "$WORKTREES_ROOT" -mindepth 2 -maxdepth 2 -type d 2>/dev/null || true)
  fi
  return 0
}

list_docker_rows() {
  if ! docker info >/dev/null 2>&1; then
    return 0
  fi
  docker ps -a --format '{{.ID}}\t{{.Status}}\t{{.Names}}\t{{.Image}}\t{{.Ports}}' 2>/dev/null || true
}

list_docker_ids() {
  local exited_only="${1:-0}"
  local id status
  while IFS=$'\t' read -r id status _ _ _; do
    [[ -z "$id" ]] && continue
    if [[ "$exited_only" == "1" && "$status" != Exited* && "$status" != Created* && "$status" != Dead* ]]; then
      continue
    fi
    printf '%s\n' "$id"
  done < <(list_docker_rows)
  return 0
}

pid_command() {
  ps -p "$1" -o command= 2>/dev/null || true
}

assert_pid_kind() {
  local kind="$1" pid="$2"
  local cmd
  [[ "$kind" == any ]] && return 0
  cmd=$(pid_command "$pid")
  [[ -n "$cmd" ]] || return 0
  case "$kind" in
    agents)
      [[ "$cmd" == *cursor-agent* ]] || {
        echo "pid $pid is not cursor-agent: $cmd" >&2
        return 1
      }
      ;;
    hermes)
      [[ "$cmd" == *hermes_cli.main* && "$cmd" == *"gateway restart"* ]] || {
        echo "pid $pid is not a stuck Hermes gateway restart: $cmd" >&2
        return 1
      }
      ;;
    codex)
      [[ "$cmd" == *"codex sandbox"* || "$cmd" == *node_repl* ]] || {
        echo "pid $pid is not a Codex sandbox: $cmd" >&2
        return 1
      }
      ;;
  esac
}

# --- scan ---

cmd_scan() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --only)
        ONLY="${2:-}"
        shift 2
        ;;
      --agent-idle-min)
        AGENT_IDLE_MIN="${2:-30}"
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        echo "Unknown arg: $1" >&2
        usage >&2
        exit 2
        ;;
    esac
  done

  ensure_self_pids
  load_listen_ports
  if want worktrees; then
    load_listen_cwds
  fi
  local findings=0 found pid etime cpu rss mb cwd cmd label wd path branch repo row id status names image
  emit() {
    findings=$((findings + 1))
    printf '%s\n' "$1"
  }
  section() {
    printf '\n## %s\n' "$1"
  }

  if want agents; then
    section "Idle cursor-agent"
    found=0
    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      pid=$(awk '{print $1}' <<<"$line")
      is_self_pid "$pid" && continue
      etime=$(awk '{print $3}' <<<"$line")
      cpu=$(awk '{print $4}' <<<"$line")
      rss=$(awk '{print $5}' <<<"$line")
      mins=$(etime_to_min "$etime")
      cpu_int=${cpu%.*}
      (( mins < AGENT_IDLE_MIN )) && continue
      (( cpu_int > 1 )) && continue
      cwd=$(lsof -a -d cwd -p "$pid" 2>/dev/null | awk 'NR==2 {print $NF}')
      mb=$(rss_mb "$rss")
      emit "- pid $pid · age $etime · cpu ${cpu}% · ~${mb}MB · ports $(ports_for_pid_tree "$pid") · cwd ${cwd:-?}"
      found=1
    done < <(ps -ax -o pid=,ppid=,etime=,%cpu=,rss=,command= \
      | awk '/\/cursor-agent( |$)/ && $0 !~ /worker-server/ && $0 !~ /awk/ {print}')
    (( found == 0 )) && echo "(none)"
  fi

  if want hermes; then
    section "Stuck Hermes gateway"
    found=0
    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      pid=$(awk '{print $1}' <<<"$line")
      etime=$(awk '{print $2}' <<<"$line")
      cpu=$(awk '{print $3}' <<<"$line")
      rss=$(awk '{print $4}' <<<"$line")
      mb=$(rss_mb "$rss")
      emit "- pid $pid · age $etime · cpu ${cpu}% · ~${mb}MB · ports $(ports_for_pid_tree "$pid") · hermes_cli.main gateway restart"
      found=1
    done < <(ps -ax -o pid=,etime=,%cpu=,rss=,command= \
      | awk '/hermes_cli\.main gateway restart/ && $0 !~ /awk/ {print}')
    (( found == 0 )) && echo "(none)"
  fi

  if want codex; then
    section "Idle Codex sandbox"
    found=0
    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      pid=$(awk '{print $1}' <<<"$line")
      etime=$(awk '{print $2}' <<<"$line")
      cpu=$(awk '{print $3}' <<<"$line")
      rss=$(awk '{print $4}' <<<"$line")
      mins=$(etime_to_min "$etime")
      cpu_int=${cpu%.*}
      (( mins < 60 || cpu_int > 1 )) && continue
      cmd=$(awk '{for (i=5;i<=NF;i++) printf "%s ", $i; print ""}' <<<"$line")
      label="codex sandbox"
      if [[ "$cmd" == */bin/node_repl* || "$cmd" == *" node_repl"* ]]; then
        label="codex node_repl"
      fi
      wd=""
      if [[ "$cmd" == *"--working-dir "* ]]; then
        wd=$(sed -n 's/.*--working-dir \([^ ]*\).*/\1/p' <<<"$cmd")
      fi
      mb=$(rss_mb "$rss")
      emit "- pid $pid · age $etime · cpu ${cpu}% · ~${mb}MB · ports $(ports_for_pid_tree "$pid") · $label${wd:+ · $wd}"
      found=1
    done < <(ps -ax -o pid=,etime=,%cpu=,rss=,command= \
      | awk '/codex sandbox|cua_node\/bin\/node_repl/ && $0 !~ /awk/ {print}')
    (( found == 0 )) && echo "(none)"
  fi

  if want worktrees; then
    section "Leftover worktrees"
    found=0
    declare -A seen=()
    for repo in "${KNOWN_REPOS[@]}"; do
      [[ -d "$repo/.git" || -f "$repo/.git" ]] || continue
      while IFS= read -r wt_line; do
        [[ -z "$wt_line" ]] && continue
        path=$(awk '{print $1}' <<<"$wt_line")
        [[ "$path" == "$repo" ]] && continue
        [[ -n "${seen[$path]+x}" ]] && continue
        seen[$path]=1
        branch=$(sed -n 's/.*\[\([^]]*\)\].*/\1/p' <<<"$wt_line")
        emit "- $path${branch:+ · [$branch]} · ports $(ports_for_worktree "$path") · from $(basename "$repo")"
        found=1
      done < <(git -C "$repo" worktree list 2>/dev/null || true)
    done
    if [[ -d "$WORKTREES_ROOT" ]]; then
      while IFS= read -r path; do
        [[ -z "$path" ]] && continue
        [[ -n "${seen[$path]+x}" ]] && continue
        emit "- $path · ports $(ports_for_worktree "$path") · (dir present, not in git worktree list)"
        found=1
      done < <(find "$WORKTREES_ROOT" -mindepth 2 -maxdepth 2 -type d 2>/dev/null || true)
    fi
    (( found == 0 )) && echo "(none)"
  fi

  if want docker; then
    section "Docker"
    if ! docker info >/dev/null 2>&1; then
      echo "(daemon not running)"
    else
      found=0
      local ports
      while IFS=$'\t' read -r id status names image ports; do
        [[ -z "$id" ]] && continue
        emit "- $id  $status  $names  $image  $(docker_ports_label "$ports")"
        found=1
      done < <(list_docker_rows)
      (( found == 0 )) && echo "(none)"
    fi
  fi

  printf '\n---\n'
  if (( findings == 0 )); then
    echo "Verdict: clean"
  else
    echo "Verdict: $findings hanging item(s)"
  fi
}

# --- clean ---

kill_pids() {
  local kind="$1"
  shift
  local pid still=()
  [[ $# -gt 0 ]] || return 0
  for pid in "$@"; do
    if [[ ! "$pid" =~ ^[0-9]+$ ]]; then
      echo "Not a PID: $pid" >&2
      exit 2
    fi
    if is_self_pid "$pid"; then
      echo "pid $pid: refusing to kill this session" >&2
      exit 2
    fi
    if ! kill -0 "$pid" 2>/dev/null; then
      echo "pid $pid: already gone"
      continue
    fi
    assert_pid_kind "$kind" "$pid"
    if (( DRY_RUN == 1 )); then
      echo "would kill pid $pid"
      continue
    fi
    kill "$pid"
    echo "pid $pid: sent TERM"
    still+=("$pid")
  done
  [[ ${#still[@]} -eq 0 ]] && return 0
  sleep 2
  local leftover=()
  for pid in "${still[@]}"; do
    if kill -0 "$pid" 2>/dev/null; then
      leftover+=("$pid")
    else
      echo "pid $pid: gone"
    fi
  done
  if [[ ${#leftover[@]} -eq 0 ]]; then
    return 0
  fi
  if (( KILL9 == 1 )); then
    for pid in "${leftover[@]}"; do
      kill -9 "$pid" 2>/dev/null || true
      echo "pid $pid: sent KILL"
    done
    sleep 1
    for pid in "${leftover[@]}"; do
      if kill -0 "$pid" 2>/dev/null; then
        echo "pid $pid: still alive after KILL" >&2
      else
        echo "pid $pid: gone"
      fi
    done
  else
    for pid in "${leftover[@]}"; do
      echo "pid $pid: still alive (pass --kill-9)"
    done
  fi
}

resolve_worktrees() {
  local spec="$1"
  local expanded matches=()
  expanded="${spec/#\~/$HOME}"
  if [[ -e "$expanded" ]]; then
    printf '%s\n' "$expanded"
    return 0
  fi
  if [[ "$spec" == */* && "$spec" != /* ]]; then
    expanded="$WORKTREES_ROOT/$spec"
    if [[ -e "$expanded" ]]; then
      printf '%s\n' "$expanded"
      return 0
    fi
  fi
  while IFS= read -r path; do
    [[ -z "$path" ]] && continue
    if [[ "$(basename "$path")" == "$spec" || "$path" == *"$spec" ]]; then
      matches+=("$path")
    fi
  done < <(list_worktree_paths)
  if [[ ${#matches[@]} -eq 0 ]]; then
    echo "no worktree matches: $spec" >&2
    return 1
  fi
  printf '%s\n' "${matches[@]}"
}

remove_worktree() {
  local path="$1"
  local common repo rel
  if [[ ! -e "$path" ]]; then
    echo "missing: $path" >&2
    return 1
  fi
  if (( DRY_RUN == 1 )); then
    echo "would remove worktree: $path"
    return 0
  fi
  common=$(git -C "$path" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
  if [[ -n "$common" ]]; then
    repo="${common%.git}"
    repo="${repo%/}"
    git -C "$repo" worktree remove --force "$path"
    git -C "$repo" worktree prune
    echo "removed worktree: $path"
    return 0
  fi
  rel="${path#"$WORKTREES_ROOT"/}"
  if [[ "$path" == "$WORKTREES_ROOT"/* && "$rel" != */*/* && "$rel" == */* ]]; then
    rm -rf "$path"
    echo "removed leftover dir: $path"
    return 0
  fi
  echo "not a git worktree and not under $WORKTREES_ROOT/<repo>/<slug>: $path" >&2
  return 1
}

resolve_docker() {
  local spec="$1"
  local id status names image ports
  while IFS=$'\t' read -r id status names image ports; do
    [[ -z "$id" ]] && continue
    if [[ "$id" == "$spec"* || "$names" == "$spec" ]]; then
      printf '%s\t%s\t%s\n' "$id" "$status" "$names"
      return 0
    fi
  done < <(list_docker_rows)
  echo "no docker container matches: $spec" >&2
  return 1
}

remove_docker() {
  local spec="$1"
  local id status names image
  IFS=$'\t' read -r id status names image < <(resolve_docker "$spec")
  [[ -n "$id" ]] || return 1
  if [[ "$status" == Up* ]]; then
    if (( FORCE != 1 )); then
      echo "running: $names ($id) — pass --force to remove" >&2
      return 1
    fi
    if (( DRY_RUN == 1 )); then
      echo "would remove running: $names ($id)"
      return 0
    fi
    docker rm -f "$id" >/dev/null
    echo "removed running: $names ($id)"
  else
    if (( DRY_RUN == 1 )); then
      echo "would remove: $names ($id)"
      return 0
    fi
    docker rm "$id" >/dev/null
    echo "removed: $names ($id)"
  fi
}

cmd_clean() {
  if [[ $# -lt 1 ]]; then
    echo "hanging-resources clean: pass a type (agents|hermes|codex|worktrees|docker)" >&2
    usage >&2
    exit 2
  fi
  local kind="$1"
  shift
  local all=0
  local targets=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all) all=1; shift ;;
      --dry-run) DRY_RUN=1; shift ;;
      --kill-9) KILL9=1; shift ;;
      --force) FORCE=1; shift ;;
      -h|--help) usage; exit 0 ;;
      --*) echo "Unknown flag: $1" >&2; usage >&2; exit 2 ;;
      *) targets+=("$1"); shift ;;
    esac
  done

  case "$kind" in
    agents|hermes|codex|worktrees|docker) ;;
    *)
      echo "Unknown type: $kind" >&2
      usage >&2
      exit 2
      ;;
  esac

  if (( all == 0 )) && [[ ${#targets[@]} -eq 0 ]]; then
    echo "clean $kind: pass PIDs/paths/names, or --all" >&2
    exit 2
  fi
  if (( all == 1 )) && [[ ${#targets[@]} -gt 0 ]]; then
    echo "clean $kind: use --all or targets, not both" >&2
    exit 2
  fi

  ensure_self_pids
  local ids=() spec path

  case "$kind" in
    agents|hermes|codex)
      if (( all == 1 )); then
        case "$kind" in
          agents) mapfile -t ids < <(list_agent_pids) ;;
          hermes) mapfile -t ids < <(list_hermes_pids) ;;
          codex) mapfile -t ids < <(list_codex_pids) ;;
        esac
        if [[ ${#ids[@]} -eq 0 ]]; then
          echo "clean $kind: nothing to kill"
          return 0
        fi
        echo "clean $kind --all: ${ids[*]}"
      else
        ids=("${targets[@]}")
      fi
      kill_pids "$kind" "${ids[@]}"
      ;;
    worktrees)
      if (( all == 1 )); then
        mapfile -t ids < <(list_worktree_paths)
        if [[ ${#ids[@]} -eq 0 ]]; then
          echo "clean worktrees: nothing to remove"
          return 0
        fi
        echo "clean worktrees --all: ${#ids[@]} path(s) (node_modules can make this slow)"
      else
        ids=()
        for spec in "${targets[@]}"; do
          while IFS= read -r path; do
            ids+=("$path")
          done < <(resolve_worktrees "$spec")
        done
      fi
      for path in "${ids[@]}"; do
        remove_worktree "$path"
      done
      ;;
    docker)
      if (( all == 1 )); then
        # --all never touches running containers unless --force.
        if (( FORCE == 1 )); then
          mapfile -t ids < <(list_docker_ids 0)
        else
          mapfile -t ids < <(list_docker_ids 1)
        fi
        if [[ ${#ids[@]} -eq 0 ]]; then
          echo "clean docker: nothing to remove"
          return 0
        fi
        echo "clean docker --all: ${#ids[@]} container(s)"
        for spec in "${ids[@]}"; do
          remove_docker "$spec"
        done
      else
        for spec in "${targets[@]}"; do
          remove_docker "$spec"
        done
      fi
      ;;
  esac
}

cmd_kill() {
  local targets=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --kill-9) KILL9=1; shift ;;
      --dry-run) DRY_RUN=1; shift ;;
      *) targets+=("$1"); shift ;;
    esac
  done
  if [[ ${#targets[@]} -eq 0 ]]; then
    echo "hanging-resources kill: pass one or more PIDs" >&2
    exit 2
  fi
  ensure_self_pids
  kill_pids any "${targets[@]}"
}

cmd_worktree_remove() {
  if [[ $# -eq 0 ]]; then
    echo "hanging-resources worktree-remove: pass one or more paths or slugs" >&2
    exit 2
  fi
  local spec path
  for spec in "$@"; do
    while IFS= read -r path; do
      remove_worktree "$path"
    done < <(resolve_worktrees "$spec")
  done
}

cmd_complete() {
  ensure_self_pids
  case "${1:-}" in
    agents) list_agent_pids ;;
    hermes) list_hermes_pids ;;
    codex) list_codex_pids ;;
    kill)
      list_agent_pids
      list_hermes_pids
      list_codex_pids
      ;;
    worktrees)
      local path slug repo
      while IFS= read -r path; do
        [[ -z "$path" ]] && continue
        slug=$(basename "$path")
        repo=$(basename "$(dirname "$path")")
        printf '%s\n' "$slug"
        printf '%s\n' "$repo/$slug"
        printf '%s\n' "$path"
      done < <(list_worktree_paths)
      ;;
    docker)
      local id status names image ports
      while IFS=$'\t' read -r id status names image ports; do
        [[ -z "$id" ]] && continue
        printf '%s\n' "$names"
        printf '%s\n' "$id"
      done < <(list_docker_rows)
      ;;
    *)
      echo "hanging-resources complete: agents|hermes|codex|worktrees|docker|kill" >&2
      exit 2
      ;;
  esac
}

main() {
  local sub="scan"
  if [[ $# -gt 0 ]]; then
    case "$1" in
      scan|clean|kill|worktree-remove|complete)
        sub=$1
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      -*)
        sub=scan
        ;;
      *)
        echo "Unknown command: $1" >&2
        usage >&2
        exit 2
        ;;
    esac
  fi
  case "$sub" in
    scan) cmd_scan "$@" ;;
    clean) cmd_clean "$@" ;;
    kill) cmd_kill "$@" ;;
    worktree-remove) cmd_worktree_remove "$@" ;;
    complete) cmd_complete "$@" ;;
  esac
}

main "$@"
